{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Supstack",
  "version": "0.34.1",
  "identifier": "com.supstack.app",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run web",
    "beforeBuildCommand": "npm run web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Supstack",
        "width": 1280,
        "height": 820,
        "minWidth": 360,
        "minHeight": 480,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' blob: data: https: http:",
        "media-src": "'self' blob:",
        "font-src": "'self' data: blob:",
        "connect-src": "'self' ipc: http://ipc.localhost blob: data: https://api.github.com",
        "worker-src": "'self' blob:",
        "frame-src": "'none'",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      },
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Notebooks and an agenda for Markdown notes",
    "longDescription": "Supstack shows a folder of Markdown notes as notebooks, with the list of notes and the open note side by side, with Org-style TODOs, an agenda and git sync between your devices. Notes stay plain Markdown files in your vault.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "minSdkVersion": 24
    },
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhFNDQyNDQyMzAwMEEyNzUKUldSMW9nQXdRaVJFanUrQ3lKY3FQWEhMcjhIS3IwL29sQmh2dlhSSmZxc1lnUVdIQnhUWG5tc04K",
      "endpoints": [
        "https://github.com/RuslanGagushin/supstack/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
