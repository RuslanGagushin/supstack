<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- P2P sync: WebRTC in the WebView needs to see the device's networks to offer ICE candidates.
         Without these, the relays connect (plain WebSockets) but no peer connection ever forms. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Reminders for tasks with a time (web/src/js/services/reminders.js) come at their minute: Android 13+ grants
         USE_EXACT_ALARM to a reminder app as it is installed; 12 and 12L ask for SCHEDULE_EXACT_ALARM instead. Without
         them the notification plugin falls back to an inexact alarm, which may come a few minutes late. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <application>
        <receiver android:name="com.supstack.vault.TaskWidgetProvider"
                  android:exported="false"
                  android:label="@string/task_widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <!-- Android 8+ delivers only these system broadcasts to a manifest receiver (DATE_CHANGED is not one of
                     them): the midnight alarm and updatePeriodMillis cover a new day. LOCALE_CHANGED redraws the
                     widget's own words in the new language. -->
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/task_widget_info" />
        </receiver>
        <service android:name="com.supstack.vault.TaskWidgetRows"
                 android:exported="false"
                 android:permission="android.permission.BIND_REMOTEVIEWS" />
        <!-- "Share to Supstack" (spec TASK-6): the app's own activity, made by `tauri android init`, also takes text
             and links shared from other apps; VaultPlugin.kt hands them to the page. Merged into the app's manifest. -->
        <activity android:name="com.supstack.app.MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
    </application>
</manifest>
