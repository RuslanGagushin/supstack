<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/task_widget_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/task_widget_touch"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <!-- the circle of an open task, coloured by its priority -->
        <ImageView
            android:id="@+id/task_widget_row_mark"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:importantForAccessibility="no"
            android:src="@drawable/task_widget_open_task" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/task_widget_row_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:importantForAccessibility="no"
                android:maxLines="2"
                android:textColor="@color/task_widget_ink"
                android:textSize="16sp" />

            <!-- the task's time and the note it belongs to; gone when it has neither -->
            <TextView
                android:id="@+id/task_widget_row_meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:importantForAccessibility="no"
                android:maxLines="1"
                android:textColor="@color/task_widget_muted"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <ImageView
        android:id="@+id/task_widget_row_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:background="@color/task_widget_divider"
        android:importantForAccessibility="no" />
</LinearLayout>
