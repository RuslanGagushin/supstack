{
  // Type check of web/src/js/core/ (spec QA-1): `npm run typecheck`. core/ is pure logic, so its lib has no DOM:
  // a module there that reaches for the page fails here as well as in tests/architecture.test.mjs.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": false,
    "skipLibCheck": true
  },
  "include": ["web/src/js/core/**/*.js", "web/src/js/core/globals.d.ts"]
}
